{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "www.convertleads.pro"}],
      "destination": "https://convertleads.pro/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "https://convertleads-dashboard-rho.vercel.app/dashboard" },
    { "source": "/dashboard/:path*", "destination": "https://convertleads-dashboard-rho.vercel.app/dashboard/:path*" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/case-study/:slug", "destination": "/index.html" },
    { "source": "/tools", "destination": "/index.html" }
  ]
}
